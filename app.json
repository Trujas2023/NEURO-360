{
  "expo": {
    "name": "Sense & Play Adventures 360",
    "slug": "sense-play-adventures-360",
    "description": "Comunicador AAC y juegos sensoriales offline-first para niños neurodivergentes.",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "senseplayadventures",
    "backgroundColor": "#FDF6EC",
    "primaryColor": "#7FB8A4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.senseplayadventures.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.senseplayadventures.app",
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sense & Play Adventures 360 usa la galería para que un adulto elija una foto de perfil del niño.",
          "cameraPermission": "Sense & Play Adventures 360 usa la cámara para que un adulto tome una foto de perfil del niño."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sense & Play Adventures 360 usa el micrófono para que un adulto grabe su voz en una tarjeta del comunicador. La grabación se guarda solo en este dispositivo.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/withoutUnusedPermissions.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
