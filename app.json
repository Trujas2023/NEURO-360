{
  "expo": {
    "name": "Sense & Play Adventures 360",
    "slug": "sense-play-adventures-360",
    "description": "Comunicador AAC y juegos sensoriales offline-first para niños neurodivergentes.",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "senseplayadventures",
    "backgroundColor": "#FDF6EC",
    "primaryColor": "#7FB8A4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.senseplayadventures.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.senseplayadventures.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
